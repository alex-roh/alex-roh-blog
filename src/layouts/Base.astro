---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site } from '../site';
import { href } from '../lib/posts';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title, description = site.description, noindex = false } = Astro.props;
const isPreview = import.meta.env.BASE_URL !== '/';
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL, '/'), site.url);
const nav = [['글', ''], ['시리즈', 'series/'], ['태그', 'tags/'], ['검색', 'search/']];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${site.title}` : site.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="robots" content={(noindex || isPreview) ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title || site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(href('og-image.png'), site.url)} />
    <link rel="icon" href={href('favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={href('rss.xml')} />
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    <header class="site-header">
      <a class="brand" href={href()}>{site.title}<span class="brand-dot">.</span></a>
      <nav aria-label="주 메뉴">
        {nav.map(([label,path]) => <a href={href(path)} aria-current={Astro.url.pathname === href(path) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} {site.author}</span><a href={site.github}>GitHub ↗</a><a href={href('rss.xml')}>RSS</a></footer>
  </body>
</html>
